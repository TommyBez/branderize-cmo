{
  "extends": "@repo/typescript-config/react-library.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@repo/ui/components/*": ["./src/components/*"],
      "@repo/ui/lib/*": ["./src/lib/*"],
      "@repo/ui/hooks/*": ["./src/hooks/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
