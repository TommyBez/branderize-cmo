{
  "name": "@repo/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./schema": "./src/schema.ts",
    "./schema/auth": "./src/schema/auth.ts",
    "./schema/domain": "./src/schema/domain.ts"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "test": "vitest run --root ../.. packages/db",
    "test:integration": "vitest run --root ../.. packages/db"
  },
  "dependencies": {
    "@vercel/functions": "3.7.5",
    "drizzle-orm": "0.45.2",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/pg": "8.20.0",
    "drizzle-kit": "0.31.10",
    "typescript": "5.9.2",
    "vitest": "4.1.10"
  }
}
