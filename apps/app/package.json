{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "postbuild": "node ../../scripts/upload-posthog-sourcemaps.mjs",
    "check-types": "next typegen && tsc --noEmit",
    "db:migrate": "pnpm --filter @repo/db db:migrate",
    "dev": "next dev --port 3001",
    "start": "next start",
    "test": "vitest run --root ../.. apps/app",
    "test:integration": "vitest run --root ../.. apps/app"
  },
  "dependencies": {
    "@repo/agents": "workspace:*",
    "@repo/auth": "workspace:*",
    "@repo/brain": "workspace:*",
    "@repo/connections": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/env": "workspace:*",
    "@repo/observability": "workspace:*",
    "@repo/ui": "workspace:*",
    "@vercel/blob": "2.6.1",
    "better-auth": "1.6.26",
    "drizzle-orm": "0.45.2",
    "eve": "0.31.3",
    "next": "16.3.0",
    "posthog-js": "1.409.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@posthog/cli": "0.9.2",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4",
    "@types/node": "24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "tailwindcss": "^4",
    "typescript": "5.9.2",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": "24.x",
    "pnpm": "11.x"
